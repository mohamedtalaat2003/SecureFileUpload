<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
  <PackageId>SecureFileUpload</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mohamed Talaat Mansour</Authors>
    <Description>A reusable library for secure file uploads in ASP.NET Core.</Description>
    <PackageTags>file-upload;security;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>
	
<ItemGroup>
  <None Include="README.md"
        Pack="true"
        PackagePath="\" />
</ItemGroup>
</Project>
